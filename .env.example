# ─────────────────────────────────────────────────────────────────────────────
# AmericanPolSim Bot — Variables de entorno
# Copia este archivo como .env y rellena los valores
# ─────────────────────────────────────────────────────────────────────────────

# ── Bot Discord ───────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=tu_token_aqui
DISCORD_CLIENT_ID=tu_client_id_aqui
DISCORD_GUILD_ID=tu_guild_id_aqui
BOT_PREFIX=!

# ── Base de datos MongoDB ─────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://usuario:contraseña@cluster.mongodb.net/airp-bot

# ── Integración PDA Web ───────────────────────────────────────────────────────
PDA_BACKEND_URL=https://backend-gamma-sepia-17.vercel.app/api
PDA_FRONTEND_URL=https://airp-pda.vercel.app
# Token de admin para llamadas a la API PDA
PDA_ADMIN_TOKEN=

# ── Roles Discord (IDs) ───────────────────────────────────────────────────────
DISCORD_POLICE_ROLE_ID=
DISCORD_SHERIFF_ROLE_ID=
DISCORD_FIREFIGHTER_ROLE_ID=
DISCORD_MEDIC_ROLE_ID=

# ── Webhooks Discord ──────────────────────────────────────────────────────────
DISCORD_LOG_WEBHOOK=
DISCORD_ROBOS_WEBHOOK=
DISCORD_EMERGENCIAS_WEBHOOK=
DISCORD_MULTAS_WEBHOOK=
